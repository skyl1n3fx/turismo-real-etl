    <DTS:Executable
      DTS:refId="Package\DIM_TIME"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Tarea Ejecutar SQL"
      DTS:DTSID="{F6319089-DEA3-430F-983B-5D832A7887ED}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="DIM_TIME"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2019; © 2019 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{8B687742-3DED-4B69-B8E0-AD798854C964}"
          SQLTask:SqlStatementSource="SET LANGUAGE SPANISH;&#xA;DECLARE @FECHA_COMPLETA AS DATETIME, &#xA;@ANIO AS CHAR(4), @MES AS SMALLINT, @MES_LETRA AS CHAR(10),&#xA;@SEMESTRE AS SMALLINT, @TRIMESTRE AS SMALLINT, @SEMESTRE_LETRA AS CHAR(20), @TRIMESTRE_LETRA AS CHAR(20),&#xA;@DIA AS SMALLINT, &#xA;@SEMANA AS SMALLINT, @SEMANA_LETRA AS CHAR(20),&#xA;@QUINCENA AS SMALLINT, @QUINCENA_LETRA AS CHAR(20),&#xA;@DIA_LETRA AS CHAR(10),@HORA AS CHAR(2), @MINUTO AS CHAR(2), @SEGUNDO AS CHAR(2),&#xA;@FECHA_INICIO AS DATETIME, @FECHA_TERMINO AS DATETIME&#xA;BEGIN TRANSACTION&#xA;SELECT @FECHA_INICIO = CAST('01/01/2022 00:00:00' AS DATETIME)&#xA;SELECT @FECHA_TERMINO = CAST('31/12/2025 00:00:00' AS DATETIME)&#xA;WHILE (@FECHA_INICIO &lt;= @FECHA_TERMINO) &#xA;BEGIN&#xA;&#x9;SELECT @FECHA_COMPLETA = @FECHA_INICIO&#xA;&#x9;SELECT @ANIO = DATEPART(YYYY, @FECHA_INICIO)&#xA;&#x9;SELECT @TRIMESTRE = DATEPART(QUARTER, @FECHA_INICIO)&#xA;&#x9;SET @TRIMESTRE_LETRA = (SELECT CASE @TRIMESTRE WHEN 1 THEN 'Primer Trimestre' WHEN 2 THEN 'Segundo Trimestre' WHEN 3 THEN 'Tercer Trimestre' WHEN 4 THEN 'Cuarto Trimestre' END)&#xA;&#x9;SELECT @SEMESTRE = ((DATEPART(MM, @FECHA_INICIO) -1 ) / 6 ) + 1&#xA;&#x9;SET @SEMESTRE_LETRA = (SELECT CASE @SEMESTRE WHEN 1 THEN 'Primer Semestre' WHEN 2 THEN 'Segundo Semestre' END)&#xA;&#x9;SELECT @MES = DATEPART(MM, @FECHA_INICIO)&#xA;&#x9;SELECT @MES_LETRA = DATENAME(MM, @FECHA_INICIO)&#xA;&#x9;SELECT @QUINCENA = (((DATEPART(DD, @FECHA_INICIO)) - 1)/15) + 1&#xA;&#x9;IF @QUINCENA = 3 &#xA;&#x9;BEGIN&#xA;&#x9;&#x9;SET @QUINCENA = @QUINCENA - 1&#xA;&#x9;END&#xA;&#x9;SET @QUINCENA_LETRA = (SELECT CASE @QUINCENA WHEN 1 THEN 'Primera Quincena' WHEN 2 THEN 'Segunda Quincena' END)&#xA;&#x9;&#xA;&#x9;SELECT @DIA = DATEPART(DD, @FECHA_INICIO)&#xA;&#x9;SELECT @DIA_LETRA = DATENAME(DW,@FECHA_INICIO)&#xA;&#xA;&#x9;SELECT @SEMANA = datepart(week,@FECHA_INICIO) - datepart(week, dateadd(dd,-day(@FECHA_INICIO)+1,@FECHA_INICIO))+1&#xA;&#xA;&#xA;&#xA;&#x9;SET @SEMANA_LETRA = (&#xA;&#x9;&#x9;SELECT CASE @SEMANA &#xA;&#x9;&#x9;&#x9;WHEN 1 THEN 'Primera Semana' &#xA;&#x9;&#x9;&#x9;WHEN 2 THEN 'Segunda Semana' &#xA;&#x9;&#x9;&#x9;WHEN 3 THEN 'Tercera Semana'&#xA;&#x9;&#x9;&#x9;WHEN 4 THEN 'Cuarta Semana'&#xA;&#x9;&#x9;&#x9;WHEN 5 THEN 'Quinta Semana'&#xA;&#x9;&#x9;&#x9;WHEN 6 THEN 'Sexta Semana'&#xA;&#x9;&#x9;&#x9;ELSE 'N/A'&#xA;&#x9;&#x9;END&#xA;&#x9;)&#xA;&#x9;INSERT INTO TurismoRealDM.DBO.DIM_TIME&#xA;&#x9;(date_desc, year_desc, trimester_id, trimester_desc, semester_id, semester_desc, month_id, month_desc, fortnight_id, fortnight_desc, week_id, week_desc, day_id, day_desc)&#xA;&#x9;VALUES &#xA;&#x9;(@fecha_completa, @anio, @TRIMESTRE, @TRIMESTRE_LETRA, @SEMESTRE, @SEMESTRE_LETRA, @MES, @MES_LETRA, @QUINCENA, @QUINCENA_LETRA, @SEMANA, @SEMANA_LETRA, @DIA,@DIA_LETRA);&#xA;&#x9;SELECT @FECHA_INICIO =  DATEADD(DAY,1,@FECHA_INICIO)&#xA;END&#xA;COMMIT TRANSACTION" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
