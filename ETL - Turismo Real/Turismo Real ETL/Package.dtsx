                  refId="Package\DIM_CLIENT\OLE DB CLIENT ORIGIN.Connections[OleDbConnection]"
                  connectionManagerID="Package.ConnectionManagers[localhost.TurismoRealOLTP 1]"
                  connectionManagerRefId="Package.ConnectionManagers[localhost.TurismoRealOLTP 1]"
